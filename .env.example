# deepseek-tools environment template.
#
# Copy to `.env` and fill in real values:
#     cp .env.example .env
#
# `.env` is git-ignored and must NEVER be committed or exposed publicly.
# All secrets below are intentionally blank.

# Fine-grained GitHub PAT used to open issues / pull requests and read CI status.
# Required scopes for this repository: Contents, Issues, Pull requests,
# Actions (read) -- i.e. "only necessary for CI and publishing thoughts".
GITHUB_TOKEN=

# Owner/name of the repository the tools publish to.
GITHUB_REPOSITORY=fufurobot/deepseek-tools

# Base URL for the Ollama HTTP API used by the commit-message and
# fine-tuning tools.
OLLAMA_API_BASE=http://localhost:11434
